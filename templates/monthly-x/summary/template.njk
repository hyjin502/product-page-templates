<section class="mx-summary"{% if accentColor %} style="--mx-ac: {{ accentColor | hdsColor }}; --mx-ac-bg: color-mix(in srgb, {{ accentColor | hdsColor }} 4%, #fff)"{% endif %}>
  <h2 class="mx-summary__title">{{ title | rt }}</h2>
{% if paragraphs.length %}
  <div class="mx-summary__text">
{% for p in paragraphs %}
{% if p.mo %}
    <p class="only-pc">{{ p.text | rt }}</p>
    <p class="only-mo">{{ p.mo | rt }}</p>
{% else %}
    <p>{{ p.text | rt }}</p>
{% endif %}
{% endfor %}
  </div>
{% endif %}
{% if showMissions and missions.length %}
  <ul class="mx-summary__missions">
{% for m in missions %}
    <li class="mx-summary__mission">
      <p class="mx-summary__mission-title">{{ m.title }}</p>
      <div class="mx-summary__mission-body">
{% if m.desc %}
        <p>{{ m.desc | rt }}</p>
{% endif %}
{% if m.note %}
        <p class="mx-summary__mission-note">{{ m.note | rt }}</p>
{% endif %}
      </div>
    </li>
{% endfor %}
  </ul>
{% endif %}
{% if showValues and values.length %}
  <ul class="mx-summary__values">
{% for c in values %}
    <li class="mx-summary__value">
      <span class="mx-summary__value-icon" data-pick-item="values:{{ loop.index0 }}:image">{% if c.image and c.image.src %}<img src="{{ c.image.src }}" alt="{{ c.image.alt or '' }}">{% endif %}</span>
      <div class="mx-summary__value-text">
        <p class="mx-summary__value-head">{% if c.en %}<span class="mx-summary__value-en">{{ c.en }}</span>{% endif %}<strong>{{ c.title }}</strong></p>
{% if c.desc %}
        <p class="mx-summary__value-desc">{{ c.desc | rt }}</p>
{% endif %}
      </div>
    </li>
{% endfor %}
  </ul>
{% endif %}
{% if showCta and cta %}
  <a class="mx-btn{% if ctaColor == 'static/white' %} mx-btn--light{% endif %}" href="{{ ctaHref or '#' }}"{% if ctaColor %} style="--btn-bg: {{ ctaColor | hdsColor }}; --btn-fg: {{ ctaColor | hdsOn }}"{% endif %}>{{ cta }}{{ 'hds-chevron-right' | icon }}</a>
{% endif %}
</section>
