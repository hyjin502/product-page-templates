<section class="mx-summary"{% if accentColor %} style="--mx-ac: {{ accentColor | hdsColor }}; --mx-ac-bg: color-mix(in srgb, {{ accentColor | hdsColor }} 4%, #fff)"{% endif %}>
  <h2 class="mx-summary__title">{{ title | rt }}</h2>
{% if paragraphs.length %}
  <div class="mx-summary__text">
{% for p in paragraphs %}
{% if p.mo %}
    <p class="only-pc">{{ p.text | rt }}</p>
    <p class="only-mo">{{ p.mo | rt }}</p>
{% else %}
    <p>{{ p.text | rt }}</p>
{% endif %}
{% endfor %}
  </div>
{% endif %}
{% if showMissions and missionType == 'cards' and cards.length %}
  <div class="mx-summary__cards" data-mx-cards{% if iconColor %} style="--mx-ic-bg: {{ iconColor | hds200 }}"{% endif %}>
    <ul class="mx-summary__cards-track">
{% for c in cards %}
      <li class="mx-summary__card">
{% if c.icon and c.icon != 'none' %}
        <span class="mx-summary__card-ico" aria-hidden="true">{{ ('hds-' + c.icon) | icon }}</span>
{% endif %}
        <div class="mx-summary__card-text">
          <div class="mx-summary__card-head">
{% if c.sub %}
            <p class="mx-summary__card-sub">{{ c.sub }}</p>
{% endif %}
            <p class="mx-summary__card-title">{{ c.title | rt }}</p>
          </div>
{% if c.desc %}
          <p class="mx-summary__card-desc">{{ c.desc | rt }}</p>
{% endif %}
        </div>
      </li>
{% endfor %}
    </ul>
{% if cards.length > 3 %}
    <div class="mx-summary__dots">{% for i in range(0, ((cards.length + 2) / 3) | int) %}<span{% if loop.first %} class="is-on"{% endif %}></span>{% endfor %}</div>
{% endif %}
  </div>
{% elif showMissions and missions.length %}
  <ul class="mx-summary__missions">
{% for m in missions %}
    <li class="mx-summary__mission">
      <p class="mx-summary__mission-title">{{ m.title }}</p>
      <div class="mx-summary__mission-body">
{% if m.desc %}
        <p>{{ m.desc | rt }}</p>
{% endif %}
{% if m.note %}
        <p class="mx-summary__mission-note">{{ m.note | rt }}</p>
{% endif %}
      </div>
    </li>
{% endfor %}
  </ul>
{% endif %}
{% if showCta and cta %}
  <a class="mx-btn{% if ctaColor == 'static/white' %} mx-btn--light{% endif %}" href="{{ ctaHref or '#' }}"{% if ctaColor %} style="--btn-bg: {{ ctaColor | hdsColor }}; --btn-fg: {{ ctaColor | hdsOn }}"{% endif %}>{{ cta }}{{ 'hds-chevron-right' | icon }}</a>
{% endif %}
</section>
