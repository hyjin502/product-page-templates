{% set bg = bgColor | hdsBg %}{% set tc = titleColor | hdsText %}
<section class="mh-faq{% if bg and (bg | lower) in ['#ffffff', '#ffffffff'] %} mh-faq--white{% endif %}"{% if bg %} style="background: {{ bg }}"{% endif %}>
  <h2 class="mh-h mh-h--center mh-faq__title"{% if tc %} style="color: {{ tc }}"{% endif %}>{{ title | rt }}</h2>
{% if items.length %}
  <div class="mh-faq__list">
{% for it in items %}
    <details class="mh-faq__item"{% if it.open %} open{% endif %}>
      <summary class="mh-faq__q"><span>{{ it.q }}</span>{{ 'hds-chevron-right' | icon }}</summary>
{% if it.a or it.link %}
      <div class="mh-faq__a">
{% if it.a %}
        <p>{{ it.a | rt }}</p>
{% endif %}
{% if it.link %}
        <a class="mh-faq__link" href="{{ it.href or '#' }}"{% if it.href %} target="_blank" rel="noopener"{% endif %}>{{ it.link }}</a>
{% endif %}
      </div>
{% endif %}
    </details>
{% endfor %}
  </div>
{% endif %}
</section>
