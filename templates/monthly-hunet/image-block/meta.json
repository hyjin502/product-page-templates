{
  "id": "monthly-hunet-image-block",
  "section": "monthly-hunet",
  "layout": "image-block",
  "label": "이미지 섹션",
  "order": 20,
  "when": "이번 달만 쓰는 새 디자인 — Figma 에서 만든 섹션을 PC·MO 이미지로 넣어요",
  "figma": {
    "pc": null,
    "mo": null,
    "tb": null
  },
  "body": 860,
  "slots": {
    "title": {
      "type": "richtext",
      "extract": false,
      "label": "제목",
      "maxLines": 2,
      "optional": true,
      "note": "왼쪽 정렬 · 최대 2줄 · 비우면 제목 없이 이미지만"
    },
    "subtitle": {
      "type": "richtext",
      "extract": false,
      "label": "서브타이틀",
      "maxLines": 3,
      "optional": true,
      "note": "제목 아래 · 18 regular · 최대 3줄"
    },
    "image": {
      "type": "media",
      "optional": true,
      "extract": false,
      "label": "이미지",
      "hint": "PC 는 본문 폭 860(또는 화면 가득 1920) 이미지 · MO 는 375 폭 · MO 를 비우면 PC 것을 써요 · 미리보기를 클릭해도 바꿀 수 있어요"
    },
    "alt": {
      "type": "text",
      "extract": false,
      "label": "대체 텍스트",
      "maxChars": 200,
      "optional": true,
      "note": "이미지 안 글자를 적어 두면 검색·화면낭독기가 읽어요"
    },
    "href": {
      "type": "url",
      "optional": true,
      "extract": false,
      "label": "이미지 링크",
      "note": "비우면 링크 없음"
    },
    "ctas": {
      "type": "list",
      "extract": false,
      "min": 0,
      "max": 2,
      "label": "버튼",
      "note": "HDS 버튼 lg(56) · 이미지 아래 가운데 · 비우면 버튼 없음",
      "item": {
        "label": {
          "type": "text",
          "label": "버튼 문구",
          "maxChars": 20
        },
        "href": {
          "type": "url",
          "label": "링크"
        },
        "style": {
          "type": "enum",
          "values": [
            "fill",
            "outline"
          ],
          "labels": {
            "fill": "채움",
            "outline": "테두리"
          },
          "default": "fill",
          "label": "모양"
        },
        "color": {
          "type": "color",
          "default": "blue/700",
          "label": "배경색",
          "hideWhen": {
            "style": "outline"
          },
          "note": "기본 blue/700 = HDS primary"
        },
        "line": {
          "type": "color",
          "palette": "line",
          "optional": true,
          "label": "라인",
          "note": "HDS line 색 · 테두리형은 테두리 색 · 비우면 기본"
        },
        "radius": {
          "type": "radius",
          "default": "md",
          "label": "모서리",
          "note": "HDS lg 기본 md(12)"
        },
        "icon": {
          "type": "enum",
          "values": [
            "none",
            "chevron-right",
            "arrow-right",
            "plus"
          ],
          "labels": {
            "none": "없음",
            "chevron-right": "› chevron-right",
            "arrow-right": "→ arrow-right",
            "plus": "+ plus"
          },
          "default": "none",
          "label": "오른쪽 아이콘"
        }
      }
    },
    "width": {
      "type": "enum",
      "values": [
        "body",
        "full"
      ],
      "labels": {
        "body": "본문 폭(860)",
        "full": "화면 가득"
      },
      "default": "body",
      "extract": false,
      "label": "폭",
      "note": "기본은 본문 폭 860 (사용자 결정)"
    },
    "space": {
      "type": "enum",
      "values": [
        "none",
        "section"
      ],
      "labels": {
        "none": "여백 없음",
        "section": "위아래 120"
      },
      "default": "none",
      "extract": false,
      "label": "위아래 여백",
      "note": "이미지에 여백까지 들어 있으면 「여백 없음」"
    },
    "bgColor": {
      "type": "color",
      "palette": "bg",
      "free": true,
      "optional": true,
      "extract": false,
      "label": "배경색",
      "note": "이미지 바깥(양옆·위아래) 색 · 기본은 흰 바탕"
    }
  }
}
