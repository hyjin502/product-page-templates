{% set bg = bgColor | hdsBg %}{% set tinted = bg and (bg | lower) not in ['#ffffff', '#ffffffff'] %}
<section class="mh-check{% if tinted %} mh-check--tinted{% endif %}"{% if bg %} style="background: {{ bg }}"{% endif %}>
  <div class="mh-check__body">
    <h2 class="mh-h mh-h--center{% if titleColor == 'white' %} mh-h--white{% endif %}">{{ title | rt }}</h2>
    <ul class="mh-check__list">
{% for it in items %}
      <li class="mh-check__item"{% if iconColor %} style="--mh-check-icon: {{ iconColor | hdsColor }}"{% endif %}>{{ ('problem-check-circle' if (not icon or icon == 'default') else 'hds-' + icon) | icon }}<span>{{ it.text }}</span></li>
{% endfor %}
    </ul>
  </div>
</section>
