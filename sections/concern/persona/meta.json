    "tb": null
  },
  "body": 980,
  "slots": {
    "eyebrow": {
      "type": "text",
      "figmaLayer": "eyebrow",
      "optional": true,
      "label": "상단 보조 문구"
    },
    "title": {
      "type": "richtext",
      "figmaLayer": "title",
      "figmaPath": [
        "heading-pc/title",
        "heading-mo/title"
      ],
      "label": "섹션 타이틀"
    },
    "subtitle": {
      "type": "richtext",
      "figmaLayer": "subtitle",
      "optional": true,
      "label": "타이틀 아래 설명",
