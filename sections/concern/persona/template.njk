{% from "_partials/ui.njk" import ctas as ctaList, secHead, media, pagerDots %}
<section class="concern concern--persona">
  <div class="concern__body">
    {{ secHead(eyebrow, title, subtitle) }}
    <div class="concern-persona">
      <div data-pager-track class="concern-persona__track">
{% for p in personas %}
        <article class="concern-persona__card">
          <div class="concern-persona__profile">
            {{ media(p.avatar, "concern-persona__avatar") }}
            <div class="concern-persona__who">
              <p class="concern-persona__name">{{ p.name | rt }}</p>
{% if p.role %}
              <p class="concern-persona__role">{{ p.role | rt }}</p>
{% endif %}
            </div>
          </div>
          <div class="concern-persona__msg">
            <h3 class="concern-persona__title">{{ p.title | rt }}</h3>
{% if p.description %}
            <p class="concern-persona__desc">{{ p.description | rt }}</p>
{% endif %}
          </div>
        </article>
{% endfor %}
      </div>
      {{ pagerDots() }}
      <div class="concern-persona__bar" aria-hidden="true"><span class="concern-persona__thumb"></span></div>
    </div>
    {{ ctaList(ctas, "concern__btns") }}
  </div>
</section>
