{% from "_partials/ui.njk" import secHead, pagerDots %}
<section class="problem problem--icon-grid">
  <div class="problem__body">
    {{ secHead(eyebrow, title, subtitle) }}
    <div class="problem__content">
      <div data-pager-track class="problem__grid">
{% for c in items %}
        <article class="problem__card">
          <div class="problem__card-text">
            <h3 class="problem__card-title">{{ c.title }}</h3>
{% if c.description %}
            <p class="problem__text">{{ c.description | rt }}</p>
{% endif %}
          </div>
          {% if c.image and c.image.src %}
          <span class="problem__tile problem__tile--{{ c.tone or 'icon1' }}"><img src="{{ c.image.src }}" alt="{{ c.image.alt or '' }}" width="100" height="100"></span>
{% else %}
          <span class="problem__tile problem__tile--{{ c.tone or 'icon1' }}" aria-hidden="true"></span>
{% endif %}
        </article>
{% endfor %}
      </div>
      {{ pagerDots() }}
    </div>
  </div>
</section>
