{% from "_partials/ui.njk" import secHead, pagerDots %}
{% from "feature/_macros.njk" import only, note as noteBox %}
<section class="feature feature--grid feature--grid-media">
  <div class="feature__body">
    {{ secHead(eyebrow, title, subtitle) }}
    <div class="feature__content">
      <div data-pager-track class="feature__list feature__rail">
{% for c in items %}
{% set tag = 'a' if c.href else 'article' %}
        <{{ tag }} class="feature-media{{ only(c) }}"{% if c.href %} href="{{ c.href }}"{% endif %}>
{% if c.image and c.image.src %}
          <img class="feature-media__bg" src="{{ c.image.src }}" alt="{{ c.image.alt or '' }}" loading="lazy">
{% endif %}
          <div class="feature-media__text">
{% if c.caption %}
            <p class="feature-media__caption">{{ c.caption }}</p>
{% endif %}
            <h3 class="feature-media__title">{{ c.title | rt }}</h3>
          </div>
          <span class="feature-media__icon">{{ 'feature-plus-circle' | icon }}</span>
        </{{ tag }}>
{% endfor %}
      </div>
      {{ pagerDots() }}
      {{ noteBox(note) }}
    </div>
  </div>
</section>
