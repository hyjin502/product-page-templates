{% from "_partials/ui.njk" import secHead, media, pagerDots %}
{% from "feature/_macros.njk" import only, note as noteBox %}
<section class="feature feature--grid feature--grid-article">
  <div class="feature__body">
    {{ secHead(eyebrow, title, subtitle) }}
    <div class="feature__content">
      <div data-pager-track class="feature__list feature__rail">
{% for c in items %}
{% set tag = 'a' if c.href else 'article' %}
        <{{ tag }} class="feature-article{{ only(c) }}"{% if c.href %} href="{{ c.href }}"{% endif %}>
          <div class="feature-article__media">
            {{ media(c.image, "feature-article__img") }}
          </div>
          <div class="feature-article__body">
            <div class="feature-article__head">
{% if c.category %}
              <p class="feature-article__category">{{ c.category }}</p>
{% endif %}
              <h3 class="feature-article__title">{{ c.title | rt }}</h3>
            </div>
{% if c.description %}
            <p class="feature-article__desc">{{ c.description | rt }}</p>
{% endif %}
{% if c.cta %}
            <span class="feature-article__more">{{ c.cta }} {{ 'feature-chevron-sm' | icon }}</span>
{% endif %}
          </div>
        </{{ tag }}>
{% endfor %}
      </div>
      {{ pagerDots() }}
      {{ noteBox(note) }}
    </div>
  </div>
</section>
