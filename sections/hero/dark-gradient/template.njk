{% from "hero/_macros.njk" import bgMedia, lineSpans, btns %}
<section class="hero hero--dark-gradient">
  {{ bgMedia(background) }}
  <div class="hero__body">
    <div class="hero__heading">
      <h1 class="hero__title"{% if titleColor %} style="color: {{ titleColor | hdsText }}" data-hds="{{ titleColor | hdsToken('text') }}"{% endif %}>{{ lineSpans(title) }}</h1>
{% if description %}
      <p class="hero__desc"{% if descColor %} style="--hero-desc-color: {{ descColor | hdsText }}" data-hds="{{ descColor | hdsToken('text') }}"{% endif %}>{{ lineSpans(description) }}</p>
{% endif %}
    </div>
    {{ btns(ctas) }}
  </div>
</section>
