{% from "hero/_macros.njk" import bgMedia, lineSpans, btns %}
<section class="hero hero--dark-gradient">
  {{ bgMedia(background) }}
  <div class="hero__body">
    <div class="hero__heading">
      <h1 class="hero__title">{{ lineSpans(title) }}</h1>
{% if description %}
      <p class="hero__desc">{{ lineSpans(description) }}</p>
{% endif %}
    </div>
    {{ btns(ctas) }}
  </div>
</section>
