{
  "id": "hero-dark-gradient",
  "section": "hero",
  "layout": "dark-gradient",
  "label": "어두운 그라디언트",
  "order": 4,
  "when": "어두운 그라디언트 바탕에 메시지와 버튼 두 개 — 뱃지 없이 깔끔하게",
  "figma": {
    "pc": "469:32681",
    "mo": "479:33142",
    "tb": null
  },
  "body": 1200,
  "editor": true,
  "thumb": "assets/hero/thumbs/dark-gradient.jpg",
  "slots": {
    "title": {
      "type": "richtext",
      "figmaLayer": "title",
      "label": "메인 타이틀",
      "minLines": 1,
      "maxLines": 2,
      "maxChars": 17,
      "mo": {
        "maxLines": 2,
        "maxChars": 10
      }
    },
    "titleColor": {
      "type": "color",
      "palette": "text",
      "default": "white-100",
      "extract": false,
      "label": "타이틀 색",
      "note": "HDS typography 글자색 · PC·MO 같이 바뀌어요"
    },
    "description": {
      "type": "richtext",
      "figmaLayer": "description",
      "optional": true,
      "label": "서브타이틀",
      "maxLines": 2,
      "maxChars": 40,
      "mo": {
        "maxLines": 3,
        "maxChars": 27
      }
    },
    "descColor": {
      "type": "color",
      "palette": "text",
      "default": "white-80",
      "extract": false,
      "label": "서브타이틀 색",
      "note": "HDS typography 글자색 · PC·MO 같이 바뀌어요"
    },
    "ctas": {
      "type": "list",
      "figmaLayer": "cta",
      "min": 0,
      "max": 2,
      "label": "버튼",
      "item": {
        "label": {
          "type": "text",
          "figmaProp": "text-name",
          "label": "버튼 문구"
        },
        "href": {
          "type": "url",
          "label": "링크"
        },
        "style": {
          "type": "enum",
          "values": [
            "fill",
            "outline"
          ],
          "labels": {
            "fill": "채움",
            "outline": "테두리"
          },
          "default": "fill",
          "extract": false,
          "label": "모양"
        },
        "color": {
          "type": "color",
          "default": "violet/700",
          "extract": false,
          "label": "배경색",
          "hideWhen": {
            "style": "outline"
          }
        },
        "line": {
          "type": "color",
          "palette": "line",
          "optional": true,
          "extract": false,
          "label": "라인",
          "note": "HDS line 색 · 비우면 라인 없음"
        },
        "radius": {
          "type": "radius",
          "default": "full",
          "extract": false,
          "label": "모서리"
        },
        "icon": {
          "type": "enum",
          "values": [
            "none",
            "chevron-right",
            "arrow-right",
            "plus"
          ],
          "labels": {
            "none": "없음",
            "chevron-right": "› chevron-right",
            "arrow-right": "→ arrow-right",
            "plus": "+ plus"
          },
          "default": "none",
          "label": "오른쪽 아이콘",
          "note": "HDS 아이콘 · 기본은 없음"
        }
      }
    },
    "background": {
      "type": "media",
      "cssPresets": true,
      "figmaLayer": "bg",
      "extract": false,
      "optional": true,
      "label": "배경"
    }
  }
}
