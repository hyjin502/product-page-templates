{# hero 공통 매크로 — 배경 미디어 · 줄 단위 문구 · HDS 버튼 #}

{# 미디어 한 개 — m: { kind: image|video, src, poster? } | { kind: css, preset } (CSS 배경 프리셋, _backgrounds.css) #}
{% macro mediaEl(m, cls="") %}
{% if m.kind == "css" %}
<div class="hero-bgfx hero-bgfx--{{ m.preset }}{% if cls %} {{ cls }}{% endif %}"><span></span><span></span><span></span><span></span></div>
{% elif m.kind == "video" %}
<video{% if cls %} class="{{ cls }}"{% endif %} src="{{ m.src }}"{% if m.poster %} poster="{{ m.poster }}"{% endif %} autoplay muted loop playsinline></video>
{% else %}
<img{% if cls %} class="{{ cls }}"{% endif %} src="{{ m.src }}" alt="">
{% endif %}
{% endmacro %}

{# 배경 — bg: { pc: {…}, mo?: {…} }. 한쪽만 있으면 양쪽에 같은 것을 써요.
   이미지 두 장은 <picture>(MO 는 <source media>), 영상이 섞이면 PC·MO 요소를 따로 두고 .only-pc / .only-mo 로 나눠요 #}
{% macro bgMedia(bg, cls="hero__bg") %}
{% set pc = (bg.pc or bg.mo) if bg else null %}
{% set mo = (bg.mo or bg.pc) if bg else null %}
{% if pc and (pc.src or pc.kind == "css") %}
<div class="{{ cls }}" aria-hidden="true">
{% if pc.src == mo.src and pc.kind == mo.kind and pc.preset == mo.preset %}
  {{ mediaEl(pc) }}
{% elif pc.kind == "image" and mo.kind == "image" %}
  <picture><source media="(max-width: 767px)" srcset="{{ mo.src }}"><img src="{{ pc.src }}" alt=""></picture>
{% else %}
  {{ mediaEl(pc, "only-pc") }}
  {{ mediaEl(mo, "only-mo") }}
{% endif %}
</div>
{% endif %}
{% endmacro %}

{# 섹션 안 비주얼(배경이 아닌 이미지·영상) — PC·MO 따로. 이미지 두 장은 <picture> #}
{% macro visualMedia(vis, cls="hero__visual-media") %}
{% set pc = (vis.pc or vis.mo) if vis else null %}
{% set mo = (vis.mo or vis.pc) if vis else null %}
{% if pc and pc.src %}
{% if pc.src == mo.src and pc.kind == mo.kind %}
{{ mediaEl(pc, cls) }}
{% elif pc.kind != "video" and mo.kind != "video" %}
<picture class="{{ cls }}"><source media="(max-width: 767px)" srcset="{{ mo.src }}"><img src="{{ pc.src }}" alt="{{ pc.alt or '' }}"></picture>
{% else %}
{{ mediaEl(pc, cls + " only-pc") }}
{{ mediaEl(mo, cls + " only-mo") }}
{% endif %}
{% endif %}
{% endmacro %}

{# 줄마다 <span class="hero__line"> — 편집기에서 줄마다 따로 입력한 문구.
   { pc, mo } 로 MO 문구가 다르면 PC 줄 묶음(.only-pc)과 MO 줄 묶음(.only-mo)을 따로 내보내요 #}
{% macro spanList(ls) %}{% for l in ls %}{% if not loop.first %} {% endif %}<span class="hero__line">{{ l }}</span>{% endfor %}{% endmacro %}
{% macro lineSpans(value) %}{% set pcl = value | lines('pc') %}{% set mol = value | lines('mo') %}{% if pcl | join('¦') == mol | join('¦') %}{{ spanList(pcl) }}{% else %}<span class="hero__lines only-pc">{{ spanList(pcl) }}</span> <span class="hero__lines only-mo">{{ spanList(mol) }}</span>{% endif %}{% endmacro %}

{# 상단 뱃지 — 버튼처럼 배경색(HDS 버튼 색) · 테두리(HDS line 색, "none" = 빼기) · 모서리(HDS radius)를 고를 수 있어요.
   셋 다 비우면 variant 시안 모양 그대로. 고른 값만 인라인으로 덮어써요 #}
{% macro badge(text, color, line, radius) %}
{% set custom = color or (line and line != "none") %}
<p class="hero__badge{% if custom %} hero__badge--custom{% endif %}"{% if color or line or radius %} style="{% if color %}background: {{ color | hdsColor }}; color: {{ color | hdsOn }};{% endif %}{% if line == "none" %} box-shadow: none;{% elif line %} box-shadow: inset 0 0 0 1px {{ line | hdsLine }};{% endif %}{% if radius %} border-radius: {{ radius | hdsRadius }};{% endif %}" data-hds="{% if color %}{{ color | hdsToken }}{% endif %}{% if line and line != "none" %} {{ line | hdsToken('line') }}{% endif %}{% if radius %} {{ radius | hdsToken('radius') }}{% endif %}"{% endif %}>{{ text | rt }}</p>
{% endmacro %}

{# HDS 버튼 목록 — items: [{ label, href, color: HDS 색 키, radius: HDS radius 키, style?: fill|outline, arrow?: true, line?: HDS line 색 키 }]
   line 이 있으면 1px 라인(채움형은 outline, 테두리형은 그 테두리 색)을 그려요 — data-hds 에 line 토큰도 남겨요
   fill 은 고른 색이 배경(글자색은 hds.json 의 on), outline 은 테두리형(색은 variant CSS 의 --outline-*).
   data-hds 에 토큰 이름을 남겨요 (예: "color/white radius/md") #}
{% macro btns(items, cls="hero__btns") %}
{% if items and items.length %}
<div class="{{ cls }}">
{% for c in items %}
{% if c.style == "outline" %}
  <a class="hero-btn hero-btn--outline{% if c.line %} has-line{% endif %}" href="{{ c.href or '#' }}" style="--btn-r: {{ c.radius | hdsRadius }}{% if c.line %}; --btn-line: {{ c.line | hdsLine }}; --outline-line: {{ c.line | hdsLine }}{% endif %}" data-hds="outline {{ c.radius | hdsToken('radius') }}{% if c.line %} {{ c.line | hdsToken('line') }}{% endif %}">{{ c.label }}{% if c.arrow %} {{ 'chevron-right' | icon }}{% endif %}</a>
{% else %}
  <a class="hero-btn{% if c.color == 'transparent' %} hero-btn--clear{% endif %}{% if c.line %} has-line{% endif %}" href="{{ c.href or '#' }}" style="--btn-bg: {{ c.color | hdsColor }}; --btn-fg: {{ c.color | hdsOn }}; --btn-r: {{ c.radius | hdsRadius }}{% if c.line %}; --btn-line: {{ c.line | hdsLine }}{% endif %}" data-hds="{{ c.color | hdsToken }} {{ c.radius | hdsToken('radius') }}{% if c.line %} {{ c.line | hdsToken('line') }}{% endif %}">{{ c.label }}{% if c.arrow %} {{ 'chevron-right' | icon }}{% endif %}</a>
{% endif %}
{% endfor %}
</div>
{% endif %}
{% endmacro %}
