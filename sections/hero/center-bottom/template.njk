{% from "_partials/ui.njk" import ctas as ctaList, media %}
<section class="hero hero--bottom">
  <div class="hero__body">
    <div class="hero__heading">
      <div class="hero__titles">
{% if eyebrow %}
        <p class="hero__eyebrow">{{ eyebrow | rt }}</p>
{% endif %}
        <h1 class="hero__title">{{ title | rt }}</h1>
      </div>
{% if description %}
      <p class="hero__desc">{{ description | rt }}</p>
{% endif %}
    </div>
    {{ ctaList(ctas) }}
  </div>
  <div class="hero__stage">
    {{ media(image, "hero__ph") }}
  </div>
</section>
