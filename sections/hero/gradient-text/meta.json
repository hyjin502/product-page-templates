        },
        "radius": {
          "type": "radius",
          "default": "full",
          "extract": false,
          "label": "모서리"
        },
        "arrow": {
          "type": "toggle",
          "default": true,
          "extract": false,
          "label": "화살표 넣기"
        }
      }
