{% from "hero/_macros.njk" import visualMedia, lineSpans, btns %}
<section class="hero hero--visual-bottom">
  <div class="hero__body">
    <div class="hero__heading">
      <h1 class="hero__title">{{ lineSpans(title) }}</h1>
{% if description %}
      <p class="hero__desc">{{ lineSpans(description) }}</p>
{% endif %}
    </div>
    {{ btns(ctas) }}
  </div>
{% if visual %}
  <div class="hero__visual">
    {{ visualMedia(visual) }}
  </div>
{% endif %}
</section>
