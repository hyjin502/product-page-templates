{
  "id": "hero-product-shot",
  "section": "hero",
  "layout": "product-shot",
  "order": 7,
  "when": "어두운 바탕에 메시지와 버튼, 아래 제품 화면 — SaaS·앱 화면을 보여줄 때",
  "figma": {
    "pc": "471:32914",
    "mo": "479:33325",
    "tb": null
  },
  "body": 1200,
  "editor": true,
  "thumb": "assets/hero/thumbs/product-shot.jpg",
  "slots": {
    "title": {
      "type": "richtext",
      "figmaLayer": "title",
      "label": "메인 타이틀",
      "minLines": 1,
      "maxLines": 2,
      "maxChars": 14,
      "mo": {
        "maxLines": 2,
        "maxChars": 10
      }
    },
    "titleColor": {
      "type": "color",
      "palette": "text",
      "default": "white-100",
      "extract": false,
      "label": "타이틀 색",
      "note": "HDS typography 글자색 · PC·MO 같이 바뀌어요"
    },
    "description": {
      "type": "richtext",
      "figmaLayer": "description",
      "optional": true,
      "label": "서브타이틀",
      "maxLines": 2,
      "maxChars": 40,
      "mo": {
        "maxLines": 3,
        "maxChars": 22
      }
    },
    "descColor": {
      "type": "color",
      "palette": "text",
      "default": "white-80",
      "extract": false,
      "label": "서브타이틀 색",
      "note": "HDS typography 글자색 · PC·MO 같이 바뀌어요"
    },
    "ctas": {
      "type": "list",
      "figmaLayer": "cta",
      "min": 0,
      "max": 2,
      "label": "버튼",
      "item": {
        "label": {
          "type": "text",
          "figmaProp": "text-name",
          "label": "버튼 문구"
        },
        "href": {
          "type": "url",
          "label": "링크"
        },
        "color": {
          "type": "color",
          "default": "blue/700",
          "extract": false,
          "label": "배경색"
        },
        "line": {
          "type": "color",
          "palette": "line",
          "optional": true,
          "extract": false,
          "label": "라인",
          "note": "HDS line 색 · 비우면 라인 없음"
        },
        "radius": {
          "type": "radius",
          "default": "full",
          "extract": false,
          "label": "모서리"
        },
        "icon": {
          "type": "enum",
          "values": [
            "none",
            "chevron-right",
            "arrow-right",
            "plus"
          ],
          "labels": {
            "none": "없음",
            "chevron-right": "› chevron-right",
            "arrow-right": "→ arrow-right",
            "plus": "+ plus"
          },
          "default": "none",
          "label": "오른쪽 아이콘",
          "note": "HDS 아이콘 · 기본은 없음"
        }
      }
    },
    "visual": {
      "type": "media",
      "figmaLayer": "image 28",
      "extract": false,
      "optional": true,
      "label": "제품 화면 (하단 이미지)",
      "hint": "이미지 또는 mp4 · 가로 최대 1280, 잘리지 않아요 · 미리보기의 이미지를 클릭해도 바꿀 수 있어요"
    },
    "visualFit": {
      "type": "enum",
      "values": [
        "fit",
        "natural"
      ],
      "labels": {
        "fit": "가로 1280 에 맞춤",
        "natural": "이미지 원래 크기 (최대 1280)"
      },
      "default": "fit",
      "extract": false,
      "label": "제품 화면 크기",
      "note": "세로는 어느 쪽이든 이미지 비율대로예요"
    },
    "background": {
      "type": "media",
      "cssPresets": true,
      "figmaLayer": "bg",
      "extract": false,
      "optional": true,
      "label": "배경"
    }
  }
}
