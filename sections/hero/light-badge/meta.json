{
  "id": "hero-light-badge",
  "section": "hero",
  "layout": "light-badge",
  "order": 3,
  "when": "밝은 바탕에 파란 뱃지와 버튼 두 개 — 서비스·솔루션 소개 첫 화면",
  "figma": {
    "pc": "6233:29765",
    "mo": null,
    "tb": null
  },
  "body": 1200,
  "editor": true,
  "thumb": "assets/hero/thumbs/light-badge.jpg",
  "slots": {
    "eyebrow": {
      "type": "text",
      "figmaLayer": "eyebrow",
      "optional": true,
      "label": "상단 뱃지",
      "note": "문구 길이만큼 뱃지가 늘어나요"
    },
    "title": {
      "type": "richtext",
      "figmaLayer": "title",
      "label": "메인 타이틀",
      "minLines": 1,
      "maxLines": 2,
      "maxChars": 17
    },
    "description": {
      "type": "richtext",
      "figmaLayer": "description",
      "optional": true,
      "label": "서브타이틀",
      "maxLines": 2,
      "maxChars": 40
    },
    "ctas": {
      "type": "list",
      "figmaLayer": "cta",
      "min": 0,
      "max": 2,
      "label": "버튼",
      "item": {
        "label": {
          "type": "text",
          "figmaProp": "text-name",
          "label": "버튼 문구"
        },
        "href": {
          "type": "url",
          "label": "링크"
        },
        "style": {
          "type": "enum",
          "values": [
            "fill",
            "outline"
          ],
          "labels": {
            "fill": "채움",
            "outline": "테두리"
          },
          "default": "fill",
          "extract": false,
          "label": "모양"
        },
        "color": {
          "type": "color",
          "default": "blue/700",
          "extract": false,
          "label": "배경색",
          "hideWhen": {
            "style": "outline"
          }
        },
        "radius": {
          "type": "radius",
          "default": "full",
          "extract": false,
          "label": "모서리"
        },
        "arrow": {
          "type": "toggle",
          "default": true,
          "extract": false,
          "label": "화살표 넣기"
        }
      }
    },
    "background": {
      "type": "media",
      "figmaLayer": "bg-media",
      "extract": false,
      "optional": true,
      "label": "배경",
      "hint": "비우면 연한 회색 바탕 · 이미지 또는 mp4"
    }
  }
}
