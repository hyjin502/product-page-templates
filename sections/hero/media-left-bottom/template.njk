{% from "hero/_macros.njk" import badge, bgMedia, visualMedia, lineSpans, btns %}
<section class="hero hero--left hero--media-left-bottom">
  {{ bgMedia(background) }}
  <div class="hero__split">
    <div class="hero__content">
      <div class="hero__heading">
        <div class="hero__titles">
{% if eyebrow %}
          {{ badge(eyebrow, badgeColor, badgeLine, badgeRadius) }}
{% endif %}
          <h1 class="hero__title"{% if titleColor %} style="color: {{ titleColor | hdsText }}" data-hds="{{ titleColor | hdsToken('text') }}"{% endif %}>{{ lineSpans(title) }}</h1>
        </div>
{% if description %}
        <p class="hero__desc"{% if descColor %} style="--hero-desc-color: {{ descColor | hdsText }}" data-hds="{{ descColor | hdsToken('text') }}"{% endif %}>{{ lineSpans(description) }}</p>
{% endif %}
      </div>
      {{ btns(ctas) }}
    </div>
  </div>
</section>
